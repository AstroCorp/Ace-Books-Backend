{
	"name": "ace-books-backend",
	"version": "1.0.0",
	"description": "",
	"author": "Astro_Corp",
	"private": true,
	"license": "MIT",
	"scripts": {
		"build": "nest build",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"tailwind": "tailwindcss -i ./src/infrastructure/emails/css/input.css -o ./src/infrastructure/css/output.css --minify",
		"db:reset": "rm -rf ./storage/** && mikro-orm migration:fresh --seed",
		"db:regenerate-initial": "rm -f src/infrastructure/orm/migrations/*.ts dist/infrastructure/orm/migrations/* && mikro-orm schema:drop --run --drop-migrations-table && mikro-orm migration:create --initial --name=initial_tables",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --config ./src/test/e2e/jest-e2e.json",
		"test:integration": "jest --config ./src/test/integration/jest-integration.json",
		"test:unit": "jest --config ./src/test/unit/jest-unit.json"
	},
	"dependencies": {
		"@css-inline/css-inline": "^0.21.0",
		"@faker-js/faker": "~10.5.0",
		"@fastify/compress": "^9.1.0",
		"@fastify/cookie": "^11.1.2",
		"@fastify/csrf-protection": "^8.0.0",
		"@fastify/helmet": "^13.0.2",
		"@fastify/multipart": "^10.1.0",
		"@mikro-orm/core": "^7.1.9",
		"@mikro-orm/decorators": "^7.1.9",
		"@mikro-orm/migrations": "^7.1.9",
		"@mikro-orm/nestjs": "^7.0.2",
		"@mikro-orm/postgresql": "^7.1.9",
		"@mikro-orm/seeder": "^7.1.9",
		"@mikro-orm/sql-highlighter": "^1.0.1",
		"@nestjs/common": "^11.1.28",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "^11.1.28",
		"@nestjs/jwt": "^11.0.2",
		"@nestjs/passport": "^11.0.5",
		"@nestjs/platform-fastify": "^11.1.28",
		"@nestjs/schedule": "^6.1.3",
		"@nestjs/throttler": "^6.5.0",
		"@node-rs/argon2": "^2.0.2",
		"@vercel/blob": "^2.6.1",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"fastify": "5.10.0",
		"luxon": "^3.7.2",
		"nodemailer": "^9.0.3",
		"passport": "^0.7.0",
		"passport-jwt": "^4.0.1",
		"passport-local": "^1.0.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"twing": "^7.3.1",
		"uuid": "~14.0.1"
	},
	"devDependencies": {
		"@mikro-orm/cli": "^7.1.9",
		"@nestjs/cli": "^11.0.24",
		"@nestjs/schematics": "^11.1.0",
		"@nestjs/testing": "^11.1.28",
		"@swc-node/register": "^1.12.1",
		"@swc/core": "^1.15.47",
		"@types/jest": "^30.0.0",
		"@types/node": "^24.13.3",
		"@types/nodemailer": "^6.4.23",
		"@types/passport-local": "^1.0.38",
		"@types/supertest": "^7.2.0",
		"jest": "^30.3.0",
		"source-map-support": "^0.5.21",
		"supertest": "^7.2.2",
		"tailwindcss": "^3.4.19",
		"ts-jest": "^29.4.12",
		"ts-loader": "^9.5.4",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^6.0.3"
	},
	"mikro-orm": {
		"preferTs": true,
		"tsLoader": "swc",
		"configPaths": [
			"./src/infrastructure/orm/mikro-orm.config.ts",
			"./dist/infrastructure/orm/mikro-orm.config.js"
		]
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"moduleNameMapper": {
			"^@/(.*)$": "<rootDir>/src/$1"
		},
		"testEnvironment": "node"
	},
	"packageManager": "pnpm@11.18.0",
	"engines": {
		"node": ">=24.13.3"
	}
}
